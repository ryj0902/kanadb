# 운영 서버용 .env 예시 (프로젝트 루트에 .env로 저장, git 제외)
# 값이 없으면 운영 설정(prod)으로 동작한다. 로컬 개발은 DJANGO_ENV=dev 한 줄이면 된다.

DJANGO_ENV=prod
# 비우면 프로젝트 루트의 secret_key.txt를 읽는다
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# HTTPS로 서비스하는 경우 (예: https://example.com)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=False
# X-Forwarded-For를 덧붙이는 프록시 수: nginx만 1, 로드밸런서 + nginx면 2
DJANGO_NUM_PROXIES=1
# 소스의 static/ 을 웹서버가 직접 서빙하던 기존 방식을 유지하려면 그 경로를 지정
# (지정하지 않으면 staticfiles/ 에 collectstatic)
DJANGO_STATIC_ROOT=

DB_NAME=kanadb
DB_USER=kanadb_app
DB_PW=
DB_HOST=localhost
DB_PORT=3306

# --- 로컬 게임 데이터 갱신용 (manage.py build_gamedata / convert_card_images) ---
# MYSQLDUMP=C:/Program Files/MariaDB 11.1/bin/mysqldump.exe
# VIPS_BIN=C:/vips/bin
